{
  "name": "news-for-all",
  "version": "1.0.0",
  "type": "module",
  "description": "Modern-Vintage Editorial Blog & News CMS with Realtime MySQL and Admin Studio",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "client": "vite",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node -e \"import('./server/config/db.js').then(m => m.connectDB()).then(() => import('./server/seed.js')).then(s => s.seedData())\""
  },
  "keywords": [
    "news",
    "blog",
    "editorial",
    "react",
    "express",
    "mysql",
    "hostinger"
  ],
  "author": "News for All",
  "license": "ISC",
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "mongoose": "^8.12.0",
    "mysql2": "^3.24.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.1",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.3",
    "postcss-selector-parser": "^7.1.6",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss-selector-parser": "^7.1.6"
  }
}
