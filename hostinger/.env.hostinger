# ============================================================================
# Hostinger Production Environment Variables (.env)
# Copy this file to .env on your Hostinger server or enter these variables
# in Hostinger hPanel -> Websites -> Node.js -> Environment Variables
# ============================================================================

PORT=5005
NODE_ENV=production

# Hostinger MySQL Database Credentials (from hPanel -> Databases -> MySQL Databases)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=u123456789_newsforall
MYSQL_USER=u123456789_newsuser
MYSQL_PASSWORD=YOUR_HOSTINGER_MYSQL_PASSWORD

# Editorial Studio Admin Passkey
ADMIN_KEY=admin123
