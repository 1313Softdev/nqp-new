# Hostinger Apache / Shared Hosting Reverse Proxy Configuration for News for All
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect API & App Traffic to Node.js Express Backend running on internal port 5005
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ http://127.0.0.1:5005/$1 [P,L]
</IfModule>

# Enable Browser Caching & Gzip Compression on Hostinger
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
